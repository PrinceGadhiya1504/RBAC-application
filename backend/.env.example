# Flask Configuration
SECRET_KEY=dev-only-change-this-key-in-production
FLASK_DEBUG=True

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rbac_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET_KEY=your-long-random-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=30

# Initial Admin Seeding (Optional: defaults to values below if omitted)
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_PHONE=9874561230

